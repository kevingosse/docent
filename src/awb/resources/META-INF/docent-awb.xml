<idea-plugin>
    <!-- Loaded only when com.intellij.agent.workbench is present. Installs the Docent's workbench seams (thread
         directory + push notifier) at project open so "Connect agent…" and the review push path are available
         whenever AWB is present.

         NB: we do NOT enable the direct-HTTP MCP path (air.mcp.use.direct.http). It defaults to false → the
         agent reaches the IDE MCP server via the user's .mcp.json (ij-proxy stdio). See DocentWorkbenchSetup. -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- ProjectActivity (platform EP). -->
        <postStartupActivity implementation="com.kevingosse.docent.awb.DocentWorkbenchSetup"/>
    </extensions>

    <!-- Inject the Docent protocol into an AWB-launched agent's system prompt at launch, via the air.* EP
         com.intellij.air / threadLaunchContributor (interface
         com.intellij.air.backend.session.launch.AgentThreadLaunchContributor); mirrors the bundled
         AirMcpConfigLaunchContributor registration. -->
    <extensions defaultExtensionNs="com.intellij.air">
        <threadLaunchContributor implementation="com.kevingosse.docent.awb.DocentLaunchContributor"/>
    </extensions>
</idea-plugin>
